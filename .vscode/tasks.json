{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "debug fabric client",
            "type": "shell",
            "command": ".\\gradlew.bat",
            "args": [
                ":${input:mcVersion}-fabric:runClient"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "MINERSADVANTAGE_DEBUG_LOGGING": "true"
                }
            },
            "group": "build"
        },
        {
            "label": "debug fabric client (no related mods)",
            "type": "shell",
            "command": ".\\gradlew.bat",
            "args": [
                "-PdmNoRelatedMods=true",
                ":${input:mcVersion}-fabric:runClient"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "MINERSADVANTAGE_DEBUG_LOGGING": "true"
                }
            },
            "group": "build"
        },
